# ============ Manager bot ============
MANAGER_BOT_TOKEN=123456:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MANAGER_WEBHOOK_SECRET=change-me-manager-secret

# ============ Web / Webhook ============
# HTTPS domen (Telegram webhook uchun shart)
DOMAIN=https://bot.example.uz
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# ============ Database ============
DB_URL=postgresql+asyncpg://savebuilder:password@localhost:5432/savebuilder

# ============ Redis ============
REDIS_URL=redis://localhost:6379/0

# ============ Xavfsizlik ============
# Bola bot tokenlarini shifrlash uchun Fernet kaliti.
# Yaratish: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-fernet-key

# Super-admin Telegram ID(lar), vergul bilan
SUPER_ADMINS=825063446

# ============ Majburiy obuna (manager) ============
# Manager botga kirish uchun majburiy kanal(lar), @username yoki -100... id
FORCE_SUB_CHANNELS=

# ============ Muhit ============
ENV=development
LOG_LEVEL=INFO
